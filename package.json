{
  "name": "x-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "An AI copilot for x.com: an Electron shell around X with an agent sidebar driven by your local Codex CLI",
  "author": "vc0d35",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vc0d35/x-pilot.git"
  },
  "homepage": "https://github.com/vc0d35/x-pilot#readme",
  "bugs": {
    "url": "https://github.com/vc0d35/x-pilot/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "sign-dev": "bash scripts/sign-dev.sh",
    "dist": "npm run build && node scripts/render-entitlements.mjs && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "croner": "^10.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
